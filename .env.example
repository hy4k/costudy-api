# CoStudy API — copy to .env on the host (never commit real keys)

PORT=8080
NODE_ENV=production

# Supabase (service role — server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — required for embeddings + default chat
# If you see openai_quota / 429: add billing at https://platform.openai.com/account/billing
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
CHAT_MODEL_FALLBACK=gpt-4.1-mini

# Optional: chat fallback + essay grading when OpenAI chat fails
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# RAG
MATCH_THRESHOLD=0.55
TOPK=8
EMBED_CACHE_SIZE=300

# Rate limit (per IP)
AI_RATE_WINDOW_MS=60000
AI_RATE_MAX=40

# Admin extract route
ADMIN_API_KEY=change-me-long-random
